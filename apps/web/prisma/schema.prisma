// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  name             String?
  // "buyer" | "builder" | "admin"
  role             String         @default("buyer")
  stripeCustomerId String?
  // JSON string: { emailNewSub?: bool, emailCancellation?: bool, emailPayment?: bool }
  notifPrefs       String         @default("{}")
  agents           Agent[]
  subscriptions    Subscription[]
  reviews          Review[]       @relation("ReviewsByBuyer")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Agent {
  id           String         @id @default(cuid())
  name         String
  tagline      String
  description  String
  vertical     String
  systemPrompt String
  // JSON string: string[] of tool IDs
  tools        String         @default("[]")
  // "flat" | "usage" | "tiered"
  pricingModel String         @default("flat")
  // in cents, e.g. 19900 = $199/mo
  priceMonthly Int            @default(0)
  trialDays    Int            @default(0)
  // "draft" | "review" | "live" | "rejected"
  status       String         @default("draft")
  // admin can pin to Featured section
  featured     Boolean        @default(false)
  // optional rejection/review notes from admin
  reviewNote   String?

  builderId     String
  builder       User           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id      String @id @default(cuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripeSessionId      String  @unique

  // "trialing" | "active" | "past_due" | "cancelled" | "incomplete"
  status           String    @default("active")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?

  integration Integration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  buyerId String
  buyer   User   @relation("ReviewsByBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  // 1–5
  rating  Int
  comment String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, buyerId])
}

model Integration {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // JSON blob: { slack?: { webhookUrl }, calendly?: { schedulingUrl },
  //   twilio?: { phoneNumber, accountSid, authToken },
  //   webhook?: { url, secret }, hubspot?: { apiKey },
  //   gmail?: { notificationEmail } }
  config    String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
