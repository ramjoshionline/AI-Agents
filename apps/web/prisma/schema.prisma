// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  // "buyer" | "builder" | "admin"
  role      String   @default("buyer")
  agents    Agent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id           String  @id @default(cuid())
  name         String
  tagline      String
  description  String
  vertical     String
  systemPrompt String
  // JSON string: string[] of tool IDs
  tools        String  @default("[]")
  // "flat" | "usage" | "tiered"
  pricingModel String  @default("flat")
  // in cents, e.g. 19900 = $199/mo
  priceMonthly Int     @default(0)
  trialDays    Int     @default(0)
  // "draft" | "review" | "live" | "rejected"
  status       String  @default("draft")
  // optional rejection/review notes from admin
  reviewNote   String?

  builderId String
  builder   User   @relation(fields: [builderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
